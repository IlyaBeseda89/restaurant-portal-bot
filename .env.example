# Скопируйте этот файл в .env и заполните. Файл .env не попадает в git.

# Токен от @BotFather
BOT_TOKEN=

# Где хранить данные: sqlite (локальный файл, для проверки) или sheets (Google Sheets)
STORAGE=sqlite
SQLITE_PATH=data/portal.sqlite3

# Для STORAGE=sheets: ключ сервисного аккаунта Google и id книги
# (id — часть ссылки на таблицу между /d/ и /edit)
GOOGLE_CREDENTIALS_FILE=secrets/google.json
SPREADSHEET_ID=

# id служебного чата обратной связи (ТУ и собственник) и чата HR.
# Узнать id: добавьте бота в чат и отправьте в нём команду /id
FEEDBACK_CHAT_ID=
HR_CHAT_ID=

# Сколько дней после даты старта сотрудник считается новичком
NEWBIE_DAYS=28
# Как часто бот перечитывает Google Sheets (секунды)
CACHE_TTL_SECONDS=60
TIMEZONE=Europe/Moscow
